ill:var(--line2)\"/><circle cx=\"259.2\" cy=\"71.3\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><text x=\"259.2\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/9</text><rect x=\"275.8\" y=\"29.1\" width=\"8.0\" height=\"27.1\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"279.8\" cy=\"48.3\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"296.4\" y=\"71.5\" width=\"8.0\" height=\"11.3\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"300.4\" cy=\"71.5\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"300.4\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/11</text><rect x=\"317.1\" y=\"54.3\" width=\"8.0\" height=\"11.8\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"321.1\" cy=\"68.1\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><rect x=\"337.7\" y=\"61.6\" width=\"8.0\" height=\"7.6\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"341.7\" cy=\"59.7\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><text x=\"341.7\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/13</text></svg><div class=\"sl\">회색 막대 — 예상 구간 · 점 — 실제 시초가 (채움: 구간 안, 테두리만: 구간 밖) · 단위 전일 종가 대비 %</div></div>\n    <div class=\"cov\">누적 57회차 — 적중(구간 안) 66.1% (37/56, 목표 80%) · 평균 구간폭 2.33%p</div>\n  </section>\n\n\n</div>","footer":{"sources":"출처 — 국내 6종, 코스피, 코스닥, 수급: 토스 중계기(KRX 1분봉, 11/13)와 한국경제(11/13 장마감, 삼성전자, SK하이닉스, 코스피 고저) 대조. 야간선물: sonmul(11/14 06:00). 주간선물: 한국경제(11/13 장마감)와 sonmul 대조. 미국 4종: stockanalysis(11/13 4:00 PM EST)와 중계기 대조. SOX, 미국 지수선물: investing.com. 환율: 15:29 매매기준율(중계기, 웹 종가 못 찾음). 이슈: 엔비디아 8-K, sonmul 증시 이슈","data_note":"종가는 중계기(KRX)와 한국경제에서 일치했습니다."}}
