th=\"8.0\" height=\"13.7\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"73.6\" cy=\"53.8\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><rect x=\"90.2\" y=\"82.1\" width=\"8.0\" height=\"32.7\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"94.2\" cy=\"95.7\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"94.2\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/19</text><rect x=\"110.8\" y=\"65.8\" width=\"8.0\" height=\"8.8\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"114.8\" cy=\"74.1\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"131.4\" y=\"43.6\" width=\"8.0\" height=\"19.7\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"135.4\" cy=\"51.7\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"135.4\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/21</text><rect x=\"152.1\" y=\"68.4\" width=\"8.0\" height=\"10.3\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"156.1\" cy=\"78.6\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"172.7\" y=\"77.2\" width=\"8.0\" height=\"27.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"176.7\" cy=\"88.9\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"176.7\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/23</text><rect x=\"193.3\" y=\"66.0\" width=\"8.0\" height=\"9.1\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"197.3\" cy=\"76.8\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><rect x=\"213.9\" y=\"33.5\" width=\"8.0\" height=\"26.2\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"217.9\" cy=\"39.8\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"217.9\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/27</text><rect x=\"234.6\" y=\"41.8\" width=\"8.0\" height=\"20.9\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"238.6\" cy=\"50.2\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"255.2\" y=\"58.1\" width=\"8.0\" height=\"12.6\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"259.2\" cy=\"68.3\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"259.2\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/29</text><rect x=\"275.8\" y=\"75.8\" width=\"8.0\" height=\"22.7\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"279.8\" cy=\"94.2\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"296.4\" y=\"79.4\" width=\"8.0\" height=\"29.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"300.4\" cy=\"82.7\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"300.4\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/2</text><rect x=\"317.1\" y=\"83.3\" width=\"8.0\" height=\"36.0\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"321.1\" cy=\"89.7\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"337.7\" y=\"44.9\" width=\"8.0\" height=\"19.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"341.7\" cy=\"48.5\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"341.7\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/4</text></svg><div class=\"sl\">회색 막대 — 예상 구간 · 점 — 실제 시초가 (채움: 구간 안, 테두리만: 구간 밖) · 단위 전일 종가 대비 %</div></div>\n    <div class=\"cov\">누적 50회차 — 적중(구간 안) 69.4% (34/49, 목표 80%) · 평균 구간폭 2.14%p</div>\n  </section>\n\n\n</div>","footer":{"sources":"출처 — 국내 6종·코스피·코스닥·수급 — 토스 중계기(KRX 1분봉, 11/4)와 한국경제(2026.11.04 장마감, 6종·주간선물) 대조. 야간선물 — sonmul.co.kr(11/5 06:00). 미국 4종 — stockanalysis(11/4 4:00 PM EST)와 중계기 대조. SOX·ES·NQ — kr.investing.com. 환율 — 중계기 15:29 매매기준율(웹 종가 미확보). 이슈 — sonmul 증시 이슈 요약(뉴스1·뉴시스·이데일리·중앙일보·파이낸셜뉴스·연합뉴스).","data_note":"국내 종가는 중계기(KRX)와 한국경제에서 일치했습니다. 미국 종가는 stockanalysis 값을 썼습니다."}}
