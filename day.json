=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"172.7\" y=\"54.4\" width=\"8.0\" height=\"11.3\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"176.7\" cy=\"58.9\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"176.7\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/28</text><rect x=\"193.3\" y=\"63.1\" width=\"8.0\" height=\"6.8\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"197.3\" cy=\"68.6\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"213.9\" y=\"72.6\" width=\"8.0\" height=\"12.2\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"217.9\" cy=\"82.6\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"217.9\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">10/30</text><rect x=\"234.6\" y=\"74.6\" width=\"8.0\" height=\"15.8\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"238.6\" cy=\"76.4\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"255.2\" y=\"76.7\" width=\"8.0\" height=\"19.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"259.2\" cy=\"80.2\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"259.2\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/3</text><rect x=\"275.8\" y=\"56.0\" width=\"8.0\" height=\"10.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"279.8\" cy=\"58.0\" r=\"3.6\" style=\"fill:var(--ok)\"/><rect x=\"296.4\" y=\"70.9\" width=\"8.0\" height=\"11.2\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"300.4\" cy=\"77.3\" r=\"3.6\" style=\"fill:var(--ok)\"/><text x=\"300.4\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/5</text><rect x=\"317.1\" y=\"87.0\" width=\"8.0\" height=\"35.4\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"321.1\" cy=\"79.2\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><rect x=\"337.7\" y=\"56.4\" width=\"8.0\" height=\"10.8\" rx=\"2\" style=\"fill:var(--line2)\"/><circle cx=\"341.7\" cy=\"71.3\" r=\"3.2\" style=\"fill:var(--panel);stroke:var(--tx2)\" stroke-width=\"1.8\"/><text x=\"341.7\" y=\"143\" font-size=\"8\" text-anchor=\"middle\" style=\"fill:var(--tx3)\">11/9</text></svg><div class=\"sl\">회색 막대 — 예상 구간 · 점 — 실제 시초가 (채움: 구간 안, 테두리만: 구간 밖) · 단위 전일 종가 대비 %</div></div>\n    <div class=\"cov\">누적 53회차 — 적중(구간 안) 67.3% (35/52, 목표 80%) · 평균 구간폭 2.26%p</div>\n  </section>\n\n\n</div>","footer":{"sources":"출처 — 국내 6종·코스피·코스닥·수급: 토스 중계기(KRX 1분봉, 11/9)와 한국경제(11/9 장마감) 대조. 미국 4종: stockanalysis(11/9 4:00 PM EST)와 중계기 대조. SOX·ES·NQ: investing.com. 야간선물: sonmul(11/10 06:00), 주간선물: 한국경제(11/9 장마감). 환율·이슈: sonmul 11/10 06:05 브리핑(뉴시스·이데일리·서울신문 등).","data_note":"종가는 중계기(KRX)와 한국경제에서 일치했습니다."}}
